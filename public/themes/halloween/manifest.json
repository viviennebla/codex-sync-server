{
  "id": "halloween-office-2026-v4-canonical",
  "theme": "halloween",
  "schemaVersion": 1,
  "designCanvas": {
    "width": 3840,
    "height": 1440
  },
  "sourceArt": {
    "width": 2048,
    "height": 768,
    "note": "Only 2048x768 contains original native visual detail; base-2560 and base-3840 are high-quality upscaled exports.",
    "repositoryMasterPath": "public/themes/halloween/art/base-master-2048.webp"
  },
  "base": {
    "variants": [
      {
        "width": 1920,
        "src": "/themes/halloween/art/base-1920.webp"
      },
      {
        "width": 2560,
        "src": "/themes/halloween/art/base-2560.webp"
      },
      {
        "width": 3840,
        "src": "/themes/halloween/art/base-3840.webp"
      }
    ],
    "fallback": "/themes/halloween/art/base-1920.webp"
  },
  "layers": [
    {
      "id": "bats-static",
      "type": "image",
      "src": "/themes/halloween/art/bats-static.webp",
      "className": "season-bats-static",
      "sourceCanvas": {
        "width": 2048,
        "height": 768
      }
    },
    {
      "id": "cats-static",
      "type": "image",
      "src": "/themes/halloween/art/cats-static.webp",
      "className": "season-cats-static",
      "sourceCanvas": {
        "width": 2048,
        "height": 768
      }
    },
    {
      "id": "pumpkin-glow",
      "type": "image",
      "src": "/themes/halloween/art/glow-pumpkins.webp",
      "className": "season-glow-pumpkins",
      "durationSeconds": 4.1,
      "sourceCanvas": {
        "width": 2048,
        "height": 768
      }
    }
  ],
  "staticBats": {
    "enabled": true,
    "src": "/themes/halloween/art/bats-static.webp",
    "note": "The canonical base contains no baked-in bat silhouettes; static bats are independently removable."
  },
  "flyovers": [
    {
      "id": "bat-flyover-1",
      "src": "/themes/halloween/sprites/bat-flyover-01.webp",
      "topPercent": 14,
      "delaySeconds": -3,
      "durationSeconds": 24,
      "size": 42
    },
    {
      "id": "bat-flyover-2",
      "src": "/themes/halloween/sprites/bat-flyover-02.webp",
      "topPercent": 26,
      "delaySeconds": -13,
      "durationSeconds": 33,
      "size": 34
    }
  ],
  "accessories": {
    "enabled": true,
    "variants": [
      "witch",
      "pumpkin",
      "ghost",
      "cat"
    ],
    "policy": "stable per user_id, independent of token usage"
  },
  "effects": {
    "motionReducedDisablesAnimations": true,
    "pointerEvents": "none",
    "seasonalWindow": "October 18 – November 1 (Asia/Shanghai)",
    "force": "?season=halloween",
    "off": "?season=off",
    "pumpkinGlow": {
      "enabled": true,
      "periodSeconds": 4.1,
      "opacityMin": 0.1,
      "opacityMax": 1
    },
    "staticCats": true,
    "staticBats": true
  },
  "artworkRegistration": {
    "canvas": {
      "width": 2048,
      "height": 768
    },
    "coordinateOrigin": "top-left",
    "crop": "center/cover",
    "renderOrder": [
      "base",
      "bats-static",
      "cats-static",
      "pumpkin-glow",
      "riders"
    ],
    "method": "Generated companion transparent layers aligned to the chosen clean-scene image; composite checked at original 2048x768 without independently scaling overlays.",
    "note": "Only files referenced in this manifest are used at runtime. Original approved design references remain in docs; legacy runtime assets have been deleted."
  }
}
