{
  "name": "codex-sync-server",
  "version": "1.0.0",
  "description": "Headless sync server for Codex Usage Dashboard — stores device snapshots, serves pull endpoints",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "preview": "node scripts/preview.mjs",
    "riders:validate": "node scripts/rider-packs.mjs validate",
    "riders:import": "node scripts/rider-packs.mjs import",
    "vehicles:import": "node scripts/rider-packs.mjs import-vehicle"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "pngjs": "^7.0.0"
  }
}
